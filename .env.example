# ─────────────────────────────────────────────────────────────
# Conexión con PatrimoniOS (curaduría → sitio)
# ─────────────────────────────────────────────────────────────
# Estos valores viven SOLO en el servidor (sin prefijo VITE_): el token nunca
# llega al navegador. Los consumen los proxys en src/routes/api/patrimonios/*.
#
# En local: copia este archivo a `.env` (y/o `.dev.vars`) y rellena los valores.
# En producción (Cloudflare Workers — preset `cloudflare-module` en vite.config.ts):
# configúralos como secrets del Worker:
#   npx wrangler secret put PATRIMONIOS_SITE_KEY
# (o desde el dashboard de Cloudflare → Worker → Settings → Variables).
# PATRIMONIOS_API_BASE y PATRIMONIOS_PROYECTO_ID pueden ir como vars normales;
# PATRIMONIOS_SITE_KEY debe ir como secret.

# URL base del despliegue de PatrimoniOS (sin barra final)
PATRIMONIOS_API_BASE=https://tu-patrimonios.vercel.app

# Id de la carpeta/proyecto en PatrimoniOS que se quiere publicar
PATRIMONIOS_PROYECTO_ID=id-de-la-carpeta

# Token de la carpeta (X-Site-Key). SECRETO. Se genera y se copia desde
# PatrimoniOS → carpeta → menú ⋮ → "Conexión web".
PATRIMONIOS_SITE_KEY=pega-aqui-el-token

# ─────────────────────────────────────────────────────────────
# Supabase propio del sitio (ya en uso). Placeholders — no subir valores reales.
# ─────────────────────────────────────────────────────────────
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# Captcha del formulario de aportes. Se elige el servicio poniendo SUS llaves;
# si están las dos parejas, manda hCaptcha. Sin ninguna, el formulario usa la
# comprobación de suma que vive en el propio código y sigue funcionando.
# La llave "SITE" es pública (va con VITE_ y visibilidad normal en Vercel);
# la "SECRET" nunca lleva VITE_ y en Vercel puede ir como sensible.
# ─────────────────────────────────────────────────────────────

# hCaptcha — el de los rompecabezas de imágenes. Llaves en dashboard.hcaptcha.com
# Pruebas locales: 10000000-ffff-ffff-ffff-000000000001
#                  0x0000000000000000000000000000000000000000
# VITE_HCAPTCHA_SITE_KEY=
# HCAPTCHA_SECRET_KEY=

# Cloudflare Turnstile — se resuelve solo, sin enseñar imágenes.
# Pruebas locales: 1x00000000000000000000AA
#                  1x0000000000000000000000000000000AA
# VITE_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ─────────────────────────────────────────────────────────────
# Muro de acceso TEMPORAL. Mientras esté puesto, el sitio no enseña nada a
# quien no tenga una de las tres contraseñas — ni páginas, ni acervo, ni fotos.
#
# No son cuentas: son tres claves compartidas. Al entrar se pide además el
# nombre, y cada entrada queda anotada en la tabla `accesos`, así que «quién
# entró» tiene respuesta.
#
# Para ABRIR el sitio el día del lanzamiento: MURO_ACTIVO=0 (o borrar las tres
# claves) y volver a desplegar. No hay que deshacer nada de código.
#
# Ninguna de estas variables lleva VITE_: son secretas y se comprueban en el
# servidor. En Vercel pueden ir todas como sensibles.
# ─────────────────────────────────────────────────────────────

# MURO_ACTIVO=0 apaga el muro. Sin esta variable, el muro está puesto si hay claves.
# MURO_ACTIVO=1

# Las tres claves y a quién se le dio cada una. La etiqueta es lo que aparece
# en el registro de entradas: sirve para saber por qué puerta entró la gente.
# MURO_CLAVE_1=
# MURO_ETIQUETA_1=Equipo
# MURO_CLAVE_2=
# MURO_ETIQUETA_2=Familias
# MURO_CLAVE_3=
# MURO_ETIQUETA_3=Invitados

# Con qué se firma la cookie del pase. Cualquier cadena larga y aleatoria.
# Si se cambia, todo el mundo tiene que volver a escribir su clave.
# MURO_SECRETO=
